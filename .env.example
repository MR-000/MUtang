# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Solana / Helius
HELIUS_API_KEY="your-helius-api-key"
HELIUS_WEBHOOK_SECRET="your-helius-webhook-secret"

# CoinGecko
COINGECKO_API_KEY="your-coingecko-api-key"

# OCR Server (PaddleOCR + PP-StructureV3 + InsightFace)
# 로컬 Python FastAPI 서버 주소
OCR_SERVER_URL="http://localhost:8000"

# OCR Server LLM (OpenCode)
# LLM_MODE: "local"(opencode), "cloud"(DeepSeek), "auto"(opencode 우선, 실패시 cloud)
LLM_MODE="auto"
OPENCODE_SERVER_URL="http://127.0.0.1:4096"
OPENCODE_MODEL="opencode/deepseek-v4-flash-free"

# OCR Server API Key (authentication for all endpoints) — 필수!
# 모든 요청에 X-API-Key 헤더 필요
OCR_SERVER_API_KEY="CHANGE_ME_TO_A_SECURE_KEY"

# OCR Server CORS origins — comma separated
# 미설정시 allow_origins=["*"] (allow_credentials=false)
# 명시적 설정시 allow_credentials=true
# OCR_CORS_ORIGINS="https://your-frontend.com,http://localhost:3000"

# OCR Server host (default 127.0.0.1, production은 reverse proxy 뒤에서만!)
# OCR_SERVER_HOST="127.0.0.1"

# OCR Server rate limit
# OCR_RATE_LIMIT_MAX=30
# OCR_RATE_LIMIT_WINDOW=60
# OCR_MAX_FILE_SIZE=20971520

# DeepSeek Cloud API Key (LLM_MODE=cloud 또는 auto 일 때 필요)
# https://platform.deepseek.com/ 가입 후 발급
# DEEPSEEK_API_KEY="sk-your-deepseek-key"
# CLOUD_TIMEOUT=30
# OPENCODE_TIMEOUT=120

# Admin
ADMIN_EMAIL="admin@example.com"
ADMIN_EMAIL_HASH="hashed-admin-identifier"

# Resend (문의하기 이메일 전송용)
# https://resend.com 에서 API 키 발급 후 입력
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# RESEND_FROM="MUtang <onboarding@resend.dev>"

# Webhook shared secret (for internal webhook auth)
WEBHOOK_API_KEY="your-webhook-shared-secret"

# Upstash Redis (serverless rate limiting)
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# App
APP_URL="http://localhost:3000"
